# Where core-api lives. Server-side only; the browser never sees this.
CORE_API_URL=https://app.doba.world/api-backend

# Shared secret for /admin/* on core-api. Server-side only: without it the admin
# app renders every metrics card as an empty state rather than guessing.
ADMIN_API_KEY=

# Cloudflare Access. Both are required in production; with either missing the app
# answers 503 instead of falling open.
#   team domain: https://<team>.cloudflareaccess.com
#   AUD: the Application Audience tag from the Access application
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Local development only. Never set this in production: it skips the Access check.
ADMIN_ACCESS_BYPASS=0
