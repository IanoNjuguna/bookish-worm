# Environment Variables
ADMIN_API_KEY=your-secret-key-change-this-in-production
PORT=3000
NODE_ENV=development

# Pinata IPFS
PINATA_JWT=
PINATA_API_SECRET=

# RPCs (Mainnet)
NEXT_PUBLIC_BASE_RPC_URL=

# Turso Database
