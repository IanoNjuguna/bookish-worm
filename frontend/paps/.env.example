# Strike market data: mainnet (default) or testnet
VITE_STRIKE_ENV=mainnet

# Strike builder that identities connect through. "paps" is registered on mainnet only.
VITE_BUILDER_CODE=paps

# UTXOS wallet-as-a-service (utxos.dev dashboard). Required for "Continue with Google".
VITE_UTXOS_PROJECT_ID=
VITE_NETWORK_ID=1
